# Copiază în `.env` (Copy-Item .env.example .env) și completează cheia.
# `.env` NU intră în git și nu se trimite în chat.


# Valori implicite (decomentezi doar dacă vrei să le schimbi):
# DATABASE_URL=postgresql+psycopg://mathlms:mathlms_dev_password@localhost:5433/mathlms
# CHAT_MODEL=gemini-3.8-flash
# EMBEDDING_MODEL=gemini-embedding-001

# Serviciul HTTP (`uv run uvicorn tutor.api:app --port 8001`): același token ca TUTOR_SERVICE_TOKEN din backend/.env.
# Fără el, serviciul răspunde 503 la orice cerere de ajutor.
SERVICE_TOKEN=dev-tutor-token

# Gemini (implicit), acelasi proiect si aceeasi cheie JSON ca in backend. Cheia sta IN AFARA repo-ului.
GEMINI_PROJECT=
GEMINI_CREDENTIALS_FILE=
# Ca sa folosesti OpenAI: LLM_PROVIDER=openai, CHAT_MODEL=gpt-6-luna, EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_API_KEY=
