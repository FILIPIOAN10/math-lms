# Production environment for docker-compose.prod.yml. Copy to .env.prod (gitignored) and fill EVERY value.
# Generate secrets with:  openssl rand -base64 48

# --- Public address -------------------------------------------------------------------------------------
# The https URL users type. Links in emails (verify / reset / result) point here.
FRONTEND_BASE_URL=https://mathlms.example.ro
# Host port nginx listens on (put your TLS proxy in front of it).
HTTP_PORT=80
# true REQUIRES https (the login cookie is Secure). Leave true in production.
COOKIE_SECURE=true

# --- Database & cache (private network only) ------------------------------------------------------------
POSTGRES_DB=mathlms
POSTGRES_USER=mathlms
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# --- Auth ------------------------------------------------------------------------------------------------
# Minim 32 de caractere; GENEREAZA UNUL NOU pentru productie (cel din dev nu se refoloseste).
JWT_SECRET=
JWT_EXPIRATION_MINUTES=60
# Google Cloud Console -> OAuth client. Authorized redirect URI (productie!):  https://<domeniul-tau>/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Profesorii (ADMIN) si elevii permisi la login Google, separati prin virgula, fara spatii.
ADMIN_EMAILS=
ALLOWED_EMAILS=

# --- Email (verificare cont, reset parola, rezultate) ---------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Trimite email „rezultatul e gata" elevului si parintelui (outbox, cu reincercari). Porneste-l doar cu SMTP real.
NOTIFY_RESULT_READY=false

# --- Protectii --------------------------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
SECURITY_LOG_LEVEL=INFO

# --- Monitoring (profile "monitoring") ----------------------------------------------------------------
# Token pentru /actuator/prometheus: acelasi sir si in monitoring/secrets/metrics-token (fara newline).
METRICS_TOKEN=
GRAFANA_USER=admin
GRAFANA_PASSWORD=

# --- Imagini (le seteaza workflow-ul de deploy; local lasa goale ca sa construiasca din sursa) ---------------
BACKEND_IMAGE=
FRONTEND_IMAGE=
