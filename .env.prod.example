# Production environment for docker-compose.prod.yml. Copy to .env.prod (gitignored) and fill EVERY value.
# Generate secrets with:  openssl rand -base64 48

# --- Public address -------------------------------------------------------------------------------------
# The https URL users type. Links in emails (verify / reset / result) point here.
FRONTEND_BASE_URL=https://mathlms.example.ro
# Host port nginx listens on (put your TLS proxy in front of it).
HTTP_PORT=80
# Interface it binds to. Use 127.0.0.1 when the TLS proxy (Caddy) runs on the same server, so the plain-HTTP
# port is not reachable from outside; deploy/server-setup.sh sets this (and HTTP_PORT=8080) when given DOMAIN.
HTTP_BIND=0.0.0.0
# true REQUIRES https (the login cookie is Secure). Leave true in production.
COOKIE_SECURE=true

# --- Database & cache (private network only) ------------------------------------------------------------
POSTGRES_DB=mathlms
POSTGRES_USER=mathlms
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# --- Auth ------------------------------------------------------------------------------------------------
# Minim 32 de caractere; GENEREAZA UNUL NOU pentru productie (cel din dev nu se refoloseste).
JWT_SECRET=
JWT_EXPIRATION_MINUTES=15
# Sesiunea se inchide singura dupa atatea minute fara activitate (avertisment cu 5 minute inainte).
# Cel putin cat JWT_EXPIRATION_MINUTES, altfel backend-ul nu porneste.
IDLE_TIMEOUT_MINUTES=60
# Faza 2: cate o cheie pentru fiecare treaba, NICIODATA egala cu JWT_SECRET sau intre ele (openssl rand -hex 32).
# EMAIL_TOKEN_SECRET semneaza linkurile din email si invitatiile; TOTP_ENC_KEY cripteaza secretele 2FA.
EMAIL_TOKEN_SECRET=
TOTP_ENC_KEY=
# Doar cand rotesti TOTP_ENC_KEY: valoarea veche aici, cea noua mai sus; la pornire secretele se re-cripteaza (docs/SECRETS.md).
TOTP_ENC_KEY_PREVIOUS=
# Linkurile semnate cu JWT_SECRET inainte de faza 2 expira in maxim 7 zile: pune false la o saptamana dupa deploy.
ACCEPT_LEGACY_LINK_TOKENS=true
# Google Cloud Console -> OAuth client. Authorized redirect URI (productie!):  https://<domeniul-tau>/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Profesorii (ADMIN) si elevii permisi la login Google, separati prin virgula, fara spatii.
ADMIN_EMAILS=
ALLOWED_EMAILS=
# Both administrators and teachers must enrol in authenticator-app MFA before using staff APIs.
TWO_FACTOR_REQUIRED_FOR_ADMIN=true
TWO_FACTOR_REQUIRED_FOR_TEACHER=true

# --- Email (verificare cont, reset parola, rezultate) ---------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Expeditorul: aplicatia, nu contul tau. Cu un email relay (Brevo / Amazon SES / Mailgun) SMTP_* sunt datele
# relay-ului, iar MAIL_FROM adresa verificata la el (ex. no-reply@domeniul-tau.ro). Gol = adresa din SMTP_USER
# (Gmail o pune oricum pe a lui), dar tot sub numele MAIL_FROM_NAME. MAIL_REPLY_TO: unde ajunge "Raspunde" (gol = nicaieri).
MAIL_FROM=
MAIL_FROM_NAME=Math LMS
MAIL_REPLY_TO=
# Trimite email „rezultatul e gata" elevului si parintelui (outbox, cu reincercari). Porneste-l doar cu SMTP real.
NOTIFY_RESULT_READY=false
# Reamintire "tema expira curand" (cu ~24 h inainte, doar elevilor care nu au predat). Tot outbox; porneste-l doar cu SMTP real.
NOTIFY_ASSIGNMENT_REMINDER=false
# ...si parintelui legat de elev (false = doar elevii).
NOTIFY_ASSIGNMENT_REMINDER_PARENTS=true
# Nota estimata la EN a fiecarui elev, pastrata o data pe zi (02:30), pentru graficul din „Planul pana la EN".
EN_SNAPSHOTS_ENABLED=true

# --- Protectii --------------------------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
SECURITY_LOG_LEVEL=INFO

# --- Test din poze (AI, Faza 3) ---------------------------------------------------------------------------
# Doar pagini de manual se trimit la AI. Oprit implicit; pune true + cheia furnizorului ca sa-l pornesti.
# gemini = Google Cloud (se plateste din creditul proiectului); openai = cheie OpenAI.
AI_IMPORT_ENABLED=false
AI_PROVIDER=gemini
AI_DAILY_PAGE_LIMIT=50
# Cheie separata de cea de dezvoltare, cu limita lunara de cheltuieli setata pe platform.openai.com.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Gemini: ID-ul proiectului Google Cloud; cheia JSON a contului de serviciu sta in ./secrets/gcp-vertex.json
# (langa docker-compose.prod.yml, citibila de containerul backend - vezi docs/DEPLOY.md §8).
GEMINI_PROJECT=
GEMINI_LOCATION=global
# Only for the barem reader and grading proposals that process student work; EU multi-region, no global fallback.
GEMINI_GRADING_LOCATION=eu
GEMINI_MODEL=gemini-3.8-flash

# --- Barem din poze + propuneri AI la Subiectul III (V44) -------------------------------------------------
# Doar Gemini (acelasi proiect si aceeasi cheie JSON ca mai sus), cel mai puternic model. AI-ul doar propune punctajul,
# profesorul il confirma. Se trimit pozele baremului si, pentru o propunere, pozele raspunsului + enuntul + baremul -
# niciun nume, niciun cont. Cost orientativ (gemini-4-argon, 2026-10): ~0,08 $ un barem, ~0,07 $ o problema corectata.
AI_GRADING_ENABLED=false
AI_GRADING_PROVIDER=gemini
AI_GRADING_DAILY_LIMIT=300
AI_BAREM_DAILY_PAGES=20
GEMINI_STRONG_MODEL=gemini-4-argon

# --- Tutor: "Sugereaza indicii (AI)" in editorul intrebarii (serviciul tutor/, docs/DEPLOY.md §10) ---------------
# Ca sa porneasca: COMPOSE_PROFILES=tutor (se aduna cu alte profiluri: COMPOSE_PROFILES=tutor,monitoring), TUTOR_ENABLED=true
# si un token lung, acelasi pentru backend si tutor (openssl rand -hex 32). Foloseste Gemini (proiectul si cheia JSON de mai sus).
# Dupa o schimbare de furnizor: tutor.ingest din nou si pragul max_distance masurat din nou.
# Fara capitole construite pe server (build_chapter), tutorul raspunde doar "Nu am asta in manual."
COMPOSE_PROFILES=
TUTOR_ENABLED=false
# Required by production Compose even when the tutor profile is disabled; generate with openssl rand -hex 32.
TUTOR_SERVICE_TOKEN=
# Caseta elevului "Nu înțeleg..." (explicații AI doar din lecții): textul scris de elev ajunge la Gemini.
# Porneste-o doar dupa ce ai verificat termenii furnizorului pentru aplicatii folosite de minori.
TUTOR_STUDENT_ENABLED=false
TUTOR_STUDENT_DAILY_LIMIT=20
TUTOR_CHAT_MODEL=gemini-3.8-flash

# --- Fisiere in S3 (F11, docs/DEPLOY.md §9) - local = volumul uploads -------------------------------------
FILE_STORAGE_PROVIDER=local
S3_BUCKET=
S3_REGION=eu-central-1

# --- Backup criptat in S3 (docs/DEPLOY.md §4) - deploy/backup.sh REFUZA sa ruleze fara ele ----------------
# Cheia PUBLICA age ("age1..."); cheia privata NU sta pe server (manager de parole + secretul GitHub BACKUP_AGE_IDENTITY).
BACKUP_AGE_RECIPIENT=
# Un bucket separat de cel cu fisiere, cu versionare si regula de stergere dupa 90 de zile.
BACKUP_S3_BUCKET=
# Fara AWS (Cloudflare R2, Contabo Object Storage...; docs/DEPLOY.md §4): adresa S3-compatibila, regiunea (R2: auto) si o cheie
# doar pentru bucket-ul de backup. Pe EC2 lasa-le goale: se foloseste rolul instantei.
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=

# --- Monitoring (profile "monitoring") ----------------------------------------------------------------
# Token pentru /actuator/prometheus: acelasi sir si in monitoring/secrets/metrics-token (fara newline).
METRICS_TOKEN=
GRAFANA_USER=admin
# Required by production Compose; generate with openssl rand -hex 32.
GRAFANA_PASSWORD=

# --- Imagini (le seteaza workflow-ul de deploy; local lasa goale ca sa construiasca din sursa) ---------------
BACKEND_IMAGE=
FRONTEND_IMAGE=
TUTOR_IMAGE=

# --- Memory caps (optional; defaults in docker-compose.prod.yml fit a 4 GB host) ---
# Each container is capped so one cannot starve the rest; the JVM sizes its heap to 75% of BACKEND_MEM_LIMIT.
# On a 2 GB host turn the tutor/monitoring profiles off and use e.g. BACKEND_MEM_LIMIT=1g, POSTGRES_MEM_LIMIT=384m.
# BACKEND_MEM_LIMIT=1536m
# TUTOR_MEM_LIMIT=768m
# POSTGRES_MEM_LIMIT=512m
# REDIS_MEM_LIMIT=128m
# FRONTEND_MEM_LIMIT=64m
# PROMETHEUS_MEM_LIMIT=256m
# ALERTMANAGER_MEM_LIMIT=64m
# GRAFANA_MEM_LIMIT=256m
