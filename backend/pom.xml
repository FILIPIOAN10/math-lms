<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>ro.mathlms</groupId>
	<artifactId>backend</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>backend</name>
	<description>Math LMS Backend</description>

	<properties>
		<java.version>21</java.version>
		<!-- Security overrides (Trivy, 2026-10-20): the versions Spring Boot 4.1.1 manages have CVEs that are fixed upstream.
		     Remove each override once the Boot parent ships these versions or newer. -->
		<jackson-bom.version>3.1.8</jackson-bom.version>     <!-- Jackson 3 core/databind DoS (CVE-2026-89407/89425/68497/91776/91777): fixed in 3.1.7 -->
		<jackson-2-bom.version>2.21.7</jackson-2-bom.version> <!-- same CVEs in Jackson 2, which only jjwt-jackson 0.13.0 still uses (Boot pins 2.21.5) -->
		<tomcat.version>11.0.27</tomcat.version>            <!-- tomcat auth/constraint bypasses (CVE-2026-65182/65905/68525): fixed from 11.0.25 -->
		<!-- Testele @Tag("e2e") (Selenium, Step Q12) sunt excluse implicit: au nevoie de stack-ul
		     pornit (backend :8080 + Vite :5173) si de Chrome. Rulare:
		     ./mvnw test -Dgroups=e2e -DexcludedGroups= -->
		<excludedGroups>e2e</excludedGroups>
		<!-- Empty default so @{argLine} below resolves even when JaCoCo's prepare-agent does not run (e.g. -Djacoco.skip). -->
		<argLine></argLine>
	</properties>

	<dependencies>
		<!-- Web / REST -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>

		<!-- RestClient.Builder for the OpenAI calls (AI import); Boot 4 auto-configures it only through this starter -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-restclient</artifactId>
		</dependency>

		<!-- Security + Google OAuth2 login (Step 1.3) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security-oauth2-client</artifactId>
		</dependency>

		<!-- Persistence (Step 1.2) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>

		<!-- Redis: rate limiting (Phase 6) + caching (Phase 5) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-redis</artifactId>
		</dependency>

		<!-- Bean validation on DTOs -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<!-- Email: verificare cont, reset parola, notificare aprobare (Step 1.6a) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-mail</artifactId>
		</dependency>

		<!-- F11: files on AWS S3 (FILE_STORAGE_PROVIDER=s3). The MinIO client speaks plain S3 and takes the EC2 instance
		     role's credentials; it is only used when the s3 provider is on (local disk stays the default). -->
		<dependency>
			<groupId>io.minio</groupId>
			<artifactId>minio</artifactId>
			<version>9.0.3</version>
		</dependency>
		<!-- "Test din poze" takes scanned PDFs: each page is rendered to an image before it is read. -->
		<dependency>
			<groupId>org.apache.pdfbox</groupId>
			<artifactId>pdfbox</artifactId>
			<version>3.0.8</version>
		</dependency>
		<!-- okhttp 5's "okhttp" jar is an empty stub for Gradle (Kotlin multiplatform); Maven needs the JVM jar named. -->
		<dependency>
			<groupId>com.squareup.okhttp3</groupId>
			<artifactId>okhttp-jvm</artifactId>
			<version>5.3.2</version>
		</dependency>
		<!-- Security override (Trivy, 2026-10-25): minio 9.0.3 brings bcprov 1.84 - CVE-2026-8763 (CRITICAL, name
		     constraints bypass) and CVE-2026-13506 (HIGH, ASN.1 DoS), fixed in 1.85. Drop once minio ships 1.85+. -->
		<dependency>
			<groupId>org.bouncycastle</groupId>
			<artifactId>bcprov-jdk18on</artifactId>
			<version>1.86</version>
		</dependency>
		<!-- Security override (Trivy, 2026-10-30): minio 9.0.3 brings guava 33.6.0 (CVE-2026-102554) and snappy-java
		     1.1.10.8 (CVE-2026-93451, CVE-2026-108106), all HIGH. Drop once minio ships newer ones. -->
		<dependency>
			<groupId>com.google.guava</groupId>
			<artifactId>guava</artifactId>
			<version>33.7.2-jre</version>
		</dependency>
		<dependency>
			<groupId>org.xerial.snappy</groupId>
			<artifactId>snappy-java</artifactId>
			<version>1.1.10.9</version>
		</dependency>

		<!-- Health checks for Docker / CI + metrics (Phase 6.3) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-registry-prometheus</artifactId>
		</dependency>

		<!-- Flyway: versioned schema migrations (Step 1.2). Boot 4 auto-configures Flyway only through its starter. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>

		<!-- Hot restart in dev -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-devtools</artifactId>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency>

		<!-- PostgreSQL JDBC driver -->
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- Lombok: getters / constructors boilerplate (version managed by parent) -->
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>

		<!-- JWT: sign / validate our own tokens stored in the HttpOnly cookie -->
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-api</artifactId>
			<version>0.13.0</version>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-impl</artifactId>
			<version>0.13.0</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-jackson</artifactId>
			<version>0.13.0</version>
			<scope>runtime</scope>
		</dependency>

		<!-- Testing: JUnit 5, Mockito, AssertJ. Boot 4 splits test slices per module: each *-test starter brings the
		     @WebMvcTest / @DataJpaTest / @AutoConfigureMockMvc / @AutoConfigureMetrics support for that module. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- TestRestTemplate (real-port tests) lives in its own module in Boot 4 -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-resttestclient</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- Testcontainers 2: real PostgreSQL in repository tests (Step 1.2) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-testcontainers</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-postgresql</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- E2E in browser real (Step Q12). Versiunea e gestionata de Boot (selenium-bom).
		     Selenium Manager (inclus din 4.6) descarca singur ChromeDriver-ul potrivit. -->
		<dependency>
			<groupId>org.seleniumhq.selenium</groupId>
			<artifactId>selenium-java</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!-- Mockito as a -javaagent (its documented setup for JDK 21+): without it Mockito attaches itself at run time and the
			     JVM warns that dynamic agent loading will be disallowed in a future release. `properties` exposes the jar's path
			     as ${org.mockito:mockito-core:jar}; @{argLine} keeps JaCoCo's agent, which prepare-agent puts in argLine. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<executions>
					<execution>
						<goals>
							<goal>properties</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<argLine>@{argLine} -javaagent:${org.mockito:mockito-core:jar}</argLine>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
			<!-- JaCoCo: raport de acoperire a testelor (generat la faza verify) -->
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<!-- Pinned: without a version Maven picks whatever is newest (and warns), so a release could change the build. -->
				<version>0.8.15</version>
				<executions>
					<execution>
						<id>prepare-agent</id>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>report</id>
						<phase>verify</phase>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
