# Sablon pentru variabilele de mediu. Copiaza acest fisier ca `.env` si completeaza valorile reale.
# `.env` NU se comite niciodata (este in .gitignore).

# Google Cloud Console -> Google Auth Platform -> Clients -> OAuth client ID (Web application)
# Authorized redirect URI: http://localhost:8080/login/oauth2/code/google
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Controlul accesului: doar emailurile de mai jos se pot loga.
# Profesorii (rol ADMIN) - separate prin virgula, fara spatii.
ADMIN_EMAILS=profesor@gmail.com
# Elevii (rol STUDENT) - separate prin virgula. Poate fi si gol.
ALLOWED_EMAILS=elev1@gmail.com,elev2@gmail.com

# Cheia de semnare JWT. Minim 32 de caractere.
# Genereaza una noua cu: openssl rand -base64 48
JWT_SECRET=change-me-with-a-long-random-string-at-least-32-chars

# Durata de viata a token-ului, in minute.
JWT_EXPIRATION_MINUTES=60

# Flag-ul Secure pe cookie-ul de autentificare. In productie (HTTPS) lasa-l true.
# Pentru dezvoltare locala pe http://localhost pune-l false, altfel browserul nu
# trimite cookie-ul si login-ul pare ca nu functioneaza.
COOKIE_SECURE=false

# Nivel de logging pentru Spring Security. In productie lasa-l INFO (implicit, omite linia);
# pune DEBUG doar pentru depanare locala a fluxului de autentificare.
SECURITY_LOG_LEVEL=DEBUG

# SMTP pentru emailuri (verificare cont, reset parola, aprobare) - Step 1.6a.
# Gmail: activeaza 2FA pe cont, apoi genereaza un App Password
# (Google Account -> Security -> 2-Step Verification -> App passwords).
# SMTP_PASS este acel App Password de 16 caractere, NU parola contului.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=adresa-ta@gmail.com
SMTP_PASS=app-password-de-16-caractere

# Email "rezultatul e gata" (elev + parinte legat), trimis prin outbox cu reincercari. Implicit OPRIT:
# porneste-l doar unde SMTP-ul e real, altfel testele/dev ar incerca sa trimita emailuri.
NOTIFY_RESULT_READY=false

# Reamintire "tema expira curand" (E7), trimisa prin outbox cu ~24 h inainte de termen elevilor care nu au predat.
# Implicit OPRITA, din acelasi motiv: porneste-o doar unde SMTP-ul e real.
NOTIFY_ASSIGNMENT_REMINDER=false
# Cand reamintirea e pornita, o primeste si parintele legat de elev (false = doar elevii).
NOTIFY_ASSIGNMENT_REMINDER_PARENTS=true

# Rate limiting (429 + Retry-After): login 5/min/IP, forgot-password 3/15min, register 5/h, upload poza 20/min/user.
# Implicit PORNIT. Pe masina de dezvoltare, unde suita E2E se logheaza de zeci de ori pe minut de la acelasi IP,
# pune false. In productie lasa true; RATE_LIMIT_TRUST_XFF=true doar in spatele nginx-ului tau.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_TRUST_XFF=false

# Token cu care Prometheus citeste /actuator/prometheus (header "Authorization: Bearer <token>"). GOL = endpoint-ul e blocat.
# Genereaza: openssl rand -hex 32  — si pune ACELASI sir in monitoring/secrets/metrics-token (fara newline).
METRICS_TOKEN=

# Faza 3 - test din poze de manual (doar pagini de manual, niciodata lucrari ale elevilor).
# Implicit OPRIT. AI_PROVIDER=fake citeste exercitii inventate (dezvoltare, fara cost);
# AI_PROVIDER=openai are nevoie de OPENAI_API_KEY (platform.openai.com, cu limita de cheltuieli setata);
# AI_PROVIDER=gemini are nevoie de GEMINI_PROJECT + GEMINI_CREDENTIALS_FILE (cheia JSON a contului de serviciu,
# tinuta IN AFARA proiectului, de ex. C:/Users/<tu>/.ssh/math-lms-vertex.json).
AI_IMPORT_ENABLED=false
AI_PROVIDER=fake
# Pagini pe zi pentru fiecare profesor (plafon de cost).
AI_DAILY_PAGE_LIMIT=50
# Cheia OpenAI (doar aici, niciodata in git sau in chat). Modelul implicit gpt-6-luna; altul cu OPENAI_MODEL.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-6-luna
GEMINI_PROJECT=
GEMINI_CREDENTIALS_FILE=
# GEMINI_LOCATION=global
# GEMINI_MODEL=gemini-3.8-flash

# --- Barem din poze + propuneri AI la Subiectul III (V44) ---
# Implicit OPRIT. Doar Google (Gemini): AI_GRADING_PROVIDER=gemini foloseste GEMINI_PROJECT + GEMINI_CREDENTIALS_FILE de mai
# sus si cel mai puternic model (GEMINI_STRONG_MODEL, implicit gemini-4-argon); AI_GRADING_PROVIDER=fake = barem si
# punctaje inventate, fara retea si fara cost (dezvoltare). AI-ul doar PROPUNE punctajul; nota o dai tu.
AI_GRADING_ENABLED=false
AI_GRADING_PROVIDER=fake
# Raspunsuri propuse pe zi, pentru toata aplicatia (limiteaza costul: ~0,07 $ / problema cu gemini-4-argon in 2026-10).
# AI_GRADING_DAILY_LIMIT=300
# AI_BAREM_DAILY_PAGES=20
# GEMINI_STRONG_MODEL=gemini-4-argon
# GEMINI_GRADING_THINKING=MEDIUM
# GEMINI_BAREM_THINKING=LOW

# --- Tutor: "Sugereaza indicii (AI)" in editorul intrebarii (serviciul tutor/, FastAPI) ---
# Implicit OPRIT. Porneste serviciul (docker compose --profile tutor up -d --build tutor, sau din tutor/:
# uv run uvicorn tutor.api:app --port 8001), apoi TUTOR_ENABLED=true. Tokenul = SERVICE_TOKEN din tutor/.env.
TUTOR_ENABLED=false
# TUTOR_BASE_URL=http://localhost:8001
# TUTOR_SERVICE_TOKEN=dev-tutor-token
