# Sablon pentru variabilele de mediu. Copiaza acest fisier ca `.env` si completeaza valorile reale.
# `.env` NU se comite niciodata (este in .gitignore).

# Google Cloud Console -> Google Auth Platform -> Clients -> OAuth client ID (Web application)
# Authorized redirect URI: http://localhost:8080/login/oauth2/code/google
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Controlul accesului: doar emailurile de mai jos se pot loga.
# Profesorii (rol ADMIN) - separate prin virgula, fara spatii.
ADMIN_EMAILS=profesor@gmail.com
# Elevii (rol STUDENT) - separate prin virgula. Poate fi si gol.
ALLOWED_EMAILS=elev1@gmail.com,elev2@gmail.com

# Cheia de semnare JWT. Minim 32 de caractere.
# Genereaza una noua cu: openssl rand -base64 48
JWT_SECRET=change-me-with-a-long-random-string-at-least-32-chars

# Durata de viata a token-ului, in minute.
JWT_EXPIRATION_MINUTES=60

# SMTP pentru emailuri (verificare cont, reset parola, aprobare) - Step 1.6a.
# Gmail: activeaza 2FA pe cont, apoi genereaza un App Password
# (Google Account -> Security -> 2-Step Verification -> App passwords).
# SMTP_PASS este acel App Password de 16 caractere, NU parola contului.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=adresa-ta@gmail.com
SMTP_PASS=app-password-de-16-caractere
